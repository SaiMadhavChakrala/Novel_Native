    "policies": null,
    "functions": [
        {
            "returns": "TABLE(id uuid, title text, content text, rrf_score double precision)",
            "arguments": "query_text text, query_embedding vector, match_count integer, search_novel_id uuid",
            "definition": "CREATE OR REPLACE FUNCTION public.hybrid_search_chapters(query_text text, query_embedding vector, match_count integer, search_novel_id uuid)\n RETURNS TABLE(id uuid, title text, content text, rrf_score double precision)\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  RETURN QUERY\n  WITH semantic_search AS (\n    -- Search the chunks, not the chapters\n    SELECT chunk.id, RANK() OVER (ORDER BY chunk.embedding <=> query_embedding) as semantic_rank\n    FROM chapter_chunks chunk\n    WHERE chunk.novel_id = search_novel_id\n    LIMIT 20\n  ),\n  keyword_search AS (\n    -- Keyword search the chunks\n    SELECT chunk.id, RANK() OVER (ORDER BY ts_rank(to_tsvector('english', chunk.content), plainto_tsquery('english', query_text)) DESC) as keyword_rank\n    FROM chapter_chunks chunk\n    WHERE chunk.novel_id = search_novel_id\n      AND to_tsvector('english', chunk.content) @@ plainto_tsquery('english', query_text)\n    LIMIT 20\n  )\n  SELECT\n    c.id,\n    ch.title, -- Join back to the chapters table to get the real chapter title for citations\n    c.content,\n    (COALESCE(1.0 / (60 + ss.semantic_rank), 0.0) + COALESCE(1.0 / (60 + ks.keyword_rank), 0.0))::float AS rrf_score\n  FROM chapter_chunks c\n  JOIN chapters ch ON c.chapter_id = ch.id \n  LEFT JOIN semantic_search ss ON c.id = ss.id\n  LEFT JOIN keyword_search ks ON c.id = ks.id\n  WHERE (ss.id IS NOT NULL OR ks.id IS NOT NULL)\n    AND c.novel_id = search_novel_id\n  ORDER BY rrf_score DESC\n  LIMIT match_count;\nEND;\n$function$\n",
            "function_name": "hybrid_search_chapters"
        }
    ],
